{
  "name": "RotGS CUDA 12.8 + GUI",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "gui"
  },

  "runArgs": [
    "--gpus",
    "all"
  ],

  "containerEnv": {
    "CUDA_HOME": "/usr/local/cuda",
    "TORCH_CUDA_ARCH_LIST": "12.0",
    "UV_CACHE_DIR": "/srv/cache/uv",
    "DISPLAY": ":1",
    "QT_X11_NO_MITSHM": "1"
  },

  "mounts": [
    "source=/shared,target=/shared,type=bind",
    "source=/srv/work/users/thorbjoern,target=/srv/work/users/thorbjoern,type=bind",
    "source=/srv/scratch/thorbjoern,target=/srv/scratch/thorbjoern,type=bind",
    "source=/srv/cache/uv,target=/srv/cache/uv,type=bind",
    "source=/home/thorbjoern/.ssh,target=/home/thorbjoern/.ssh,type=bind,readonly"
  ],

  "workspaceFolder": "/workspaces/RotGS",

  "remoteUser": "thorbjoern",

  "forwardPorts": [6080],

  "portsAttributes": {
    "6080": {
      "label": "RotGS noVNC desktop",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "uv sync",
  "postStartCommand": "/usr/local/bin/start-rotgs-gui"
}
